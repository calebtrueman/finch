@@ -0,0 +1,26 @@
+#pragma once
+
+#if __has_include(<ptrauth.h>)
+#include <ptrauth.h>
+#endif
+
+namespace IAG {
+namespace swift {
+
+// A Swift closure's function pointer, as C++ calls it. On arm64e Swift signs a closure's
+// function pointer with a discriminator of the closure's Swift type, which a C++ function
+// pointer type can't name; it is re-signed as a plain function pointer.
+template <typename Function> inline Function function(Function f) {
+#if __has_feature(ptrauth_calls)
+    if (f == nullptr) {
+        return f;
+    }
+    return (Function)ptrauth_sign_unauthenticated(ptrauth_strip((void *)f, ptrauth_key_function_pointer),
+                                                  ptrauth_key_function_pointer, 0);
+#else
+    return f;
+#endif
+}
+
+} // namespace swift
+} // namespace IAG
