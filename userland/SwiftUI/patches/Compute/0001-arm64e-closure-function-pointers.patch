diff --git a/Sources/ComputeCxx/Swift/HeapObject.cpp b/Sources/ComputeCxx/Swift/HeapObject.cpp
index 54a0494..a544cc2 100644
--- a/Sources/ComputeCxx/Swift/HeapObject.cpp
+++ b/Sources/ComputeCxx/Swift/HeapObject.cpp
@@ -2,16 +2,40 @@
 
 #include <swift/Runtime/HeapObject.h>
 
+#if __APPLE__
+#include <pthread.h>
+#endif
+
 namespace IAG {
 namespace swift {
 
+/// Whether an object is on the current thread's stack: the context of a non-escaping Swift
+/// closure, which the Swift caller owns and which has no reference count to change.
+static bool on_current_stack(const void *object) noexcept {
+#if __APPLE__
+    pthread_t self = pthread_self();
+    auto top = reinterpret_cast<uintptr_t>(pthread_get_stackaddr_np(self));
+    auto size = pthread_get_stacksize_np(self);
+    auto p = reinterpret_cast<uintptr_t>(object);
+    return p < top && p >= top - size;
+#else
+    return false;
+#endif
+}
+
 IAG_NOINLINE IAG_OPTNONE void *retain(const void *object) noexcept {
     void *mutable_object = const_cast<void *>(object);
+    if (on_current_stack(object)) {
+        return mutable_object;
+    }
     return ::swift::swift_retain(reinterpret_cast<::swift::HeapObject *>(mutable_object));
 }
 
 IAG_NOINLINE IAG_OPTNONE void release(const void *object) noexcept {
     void *mutable_object = const_cast<void *>(object);
+    if (on_current_stack(object)) {
+        return;
+    }
     ::swift::swift_release(reinterpret_cast<::swift::HeapObject *>(mutable_object));
 }
 
