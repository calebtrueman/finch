diff --git a/Sources/ComputeCxx/Closure/ClosureFunction.h b/Sources/ComputeCxx/Closure/ClosureFunction.h
index 392d171..a3e0e39 100644
--- a/Sources/ComputeCxx/Closure/ClosureFunction.h
+++ b/Sources/ComputeCxx/Closure/ClosureFunction.h
@@ -3,6 +3,9 @@
 #include <concepts>
 #include <cstddef>
 #include <utility>
+#if __has_include(<ptrauth.h>)
+#include <ptrauth.h>
+#endif
 
 #include "ComputeCxx/IAGBase.h"
 #include "Swift/HeapObject.h"
@@ -79,7 +82,17 @@ class ClosureFunction {
 
     explicit operator bool() { return _function != nullptr; }
 
-    const Result operator()(Args... args) const noexcept { return _function(std::forward<Args>(args)..., _context); }
+    const Result operator()(Args... args) const noexcept {
+#if __has_feature(ptrauth_calls)
+        // Swift signs a closure's function pointer with a discriminator of the closure's
+        // type, which this C++ type can't name; it is re-signed as a plain function pointer.
+        auto function = (Function)ptrauth_sign_unauthenticated(ptrauth_strip((void *)_function, ptrauth_key_function_pointer),
+                                                                ptrauth_key_function_pointer, 0);
+        return function(std::forward<Args>(args)..., _context);
+#else
+        return _function(std::forward<Args>(args)..., _context);
+#endif
+    }
 };
 
