<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT OR Apache-2.0 -->
<!-- finch-logd (userland/logd): receives every process's os_log messages over
     the firehose (com.apple.logd, the name Finch's libsystem_trace looks up)
     and stores them for log(1). Same label and service as Apple's logd. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.logd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/finch-logd</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.logd</key>
		<true/>
	</dict>
	<!-- The log server mustn't log through itself: its first os_log message, which
	     may come before main, would register it with the firehose service that it
	     hasn't checked in for yet, and once that queue is full the send never
	     returns (docs/DEV_VM.md, "New processes stall after the jobs load"). -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>OS_ACTIVITY_MODE</key>
		<string>disable</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/finch-logd.log</string>
</dict>
</plist>
