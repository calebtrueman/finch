<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT OR Apache-2.0 -->
<!-- newsyslog (syslog, built from source): rotates the logs listed in
     /etc/newsyslog.conf and /etc/newsyslog.d, at half past every hour, as on macOS. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.newsyslog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/newsyslog</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
