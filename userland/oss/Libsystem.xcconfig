// As Apple ships libSystem.B: version 1356 (RC_ProjectSourceVersion), and no
// generated *VersionNumber/*VersionString exports.
DYLIB_CURRENT_VERSION = 1356
VERSIONING_SYSTEM =
// The asan variant links Apple-internal sanitizer runtimes Finch doesn't ship.
BUILD_VARIANTS = normal debug
