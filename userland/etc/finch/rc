#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# Finch boot script, run once by finch-init before the console shell starts.

# The VM's root is a read-only APFS ramdisk (APFS refuses to remount it
# read-write). As in macOS recovery, the writable directories get tmpfs. The
# kernel's System Policy (the sandbox's platform profile) refuses mounts over
# /private/var itself and over /private/var/db, so each other writable /var
# subdirectory gets its own. Mount points are created at image build time
# (tools/vm/mkramdisk.sh).
for dir in /private/tmp /private/var/tmp /private/var/run /private/var/log \
           /private/var/root /private/var/rw; do
    mount_tmpfs "$dir" || echo "rc: warning: tmpfs on $dir failed"
done
chmod 1777 /private/tmp /private/var/tmp
# Per-user temporary and cache directories (dirhelper's /var/folders). System
# Policy refuses tmpfs there too, so the image links it into /private/var/tmp.
mkdir -p /private/var/tmp/folders && chmod 755 /private/var/tmp/folders
# /var/db, the daemons' state, is a link into /private/var/rw for the same
# reason, and so is /Users (home directories).
mkdir -p /private/var/rw/db /private/var/rw/Users
# The time-zone database is in the image at /usr/share/zoneinfo; macOS (and
# CoreFoundation, and /etc/localtime) look in /var/db/timezone/zoneinfo.
mkdir -p /private/var/rw/db/timezone
ln -sfn /usr/share/zoneinfo /private/var/rw/db/timezone/zoneinfo
chmod 755 /private/var/rw /private/var/rw/db /private/var/rw/Users
chmod 750 /private/var/root

echo "rc: Finch userland coming up"
