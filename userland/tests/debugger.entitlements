<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- finch-app-test is a debugger of the apps it runs: it reads a crashed app's memory for its
     backtrace (crashwatch.c), as the system allows declared debuggers to with apps that
     allow debugging (get-task-allow). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.debugger</key>
	<true/>
</dict>
</plist>
