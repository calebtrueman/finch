<?xml version='1.0' encoding='utf-8'?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
  <dependencies>
    <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504" />
  </dependencies>
  <objects>
    <customObject id="-2" userLabel="File's Owner" customClass="NSObject" />
    <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
    <customObject id="-3" userLabel="Application" customClass="NSObject" />
    <gridView xPlacement="leading" yPlacement="bottom" rowAlignment="none" rowSpacing="7" columnSpacing="5" translatesAutoresizingMaskIntoConstraints="NO" id="grid">
      <rect key="frame" x="10" y="10" width="200" height="80" />
      <rows>
        <gridRow id="r1" />
        <gridRow yPlacement="center" topPadding="2" bottomPadding="3" hidden="YES" id="r2" />
        <gridRow rowAlignment="firstBaseline" height="30" id="r3" />
      </rows>
      <columns>
        <gridColumn xPlacement="trailing" leadingPadding="4" trailingPadding="1" id="c1" width="100" />
        <gridColumn width="120" xPlacement="fill" id="c2" />
      </columns>
      <gridCells>
        <gridCell row="r1" column="c1" xPlacement="center" yPlacement="top" rowAlignment="lastBaseline" id="g11">
          <textField key="contentView" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="t1">
            <rect key="frame" x="0" y="0" width="40" height="16" />
            <textFieldCell key="cell" lineBreakMode="clipping" title="Label" id="t1c">
              <font key="font" metaFont="system" />
              <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
              <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
            </textFieldCell>
          </textField>
        </gridCell>
        <gridCell row="r1" column="c2" id="g12" />
        <gridCell row="r2" column="c1" id="g21" />
        <gridCell row="r2" column="c2" id="g22" />
        <gridCell row="r3" column="c1" id="g31">
          <customView key="contentView" translatesAutoresizingMaskIntoConstraints="NO" id="v31">
            <rect key="frame" x="0" y="0" width="50" height="20" />
          </customView>
        </gridCell>
        <gridCell row="r3" column="c2" headOfMergedCell="g31" id="g32" />
      </gridCells>
    </gridView>
    <popover behavior="t" id="pop">
      <connections>
        <outlet property="contentViewController" destination="vc" id="o1" />
      </connections>
    </popover>
    <viewController id="vc">
      <connections>
        <outlet property="view" destination="pv" id="o2" />
      </connections>
    </viewController>
    <customView id="pv">
      <rect key="frame" x="0.0" y="0.0" width="150" height="90" />
    </customView>
    <pagecontroller transitionStyle="horizontalStrip" id="page" />
    <ruleEditor nestingMode="list" rowHeight="22" id="rule">
      <rect key="frame" x="320" y="120" width="270" height="100" />
      <autoresizingMask key="autoresizingMask" />
    </ruleEditor>
    <predicateEditor verticalHuggingPriority="750" nestingMode="compound" canRemoveAllRows="YES" rowHeight="25" id="pred">
      <rect key="frame" x="320" y="10" width="270" height="100" />
      <autoresizingMask key="autoresizingMask" />
      <rowTemplates>
        <predicateEditorRowTemplate rowType="compound" id="tc">
          <popUpMenus>
            <menu id="m1">
              <items>
                <menuItem title="Any" state="on" id="i1">
                  <integer key="representedObject" value="2" />
                </menuItem>
                <menuItem title="All" id="i2">
                  <integer key="representedObject" value="1" />
                </menuItem>
              </items>
            </menu>
            <menu id="m2">
              <items>
                <menuItem title="of the following are true" state="on" id="i3" />
              </items>
            </menu>
          </popUpMenus>
        </predicateEditorRowTemplate>
      </rowTemplates>
    </predicateEditor>
    <drawer id="drawer" preferredEdge="minX" leadingOffset="10" trailingOffset="15">
      <size key="contentSize" width="120" height="150" />
      <size key="minContentSize" width="50" height="50" />
      <size key="maxContentSize" width="600" height="400" />
    </drawer>
  </objects>
</document>