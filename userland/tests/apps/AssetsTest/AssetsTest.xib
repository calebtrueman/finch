<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner"/>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <textField id="1">
            <rect key="frame" x="0" y="0" width="100" height="20"/>
            <textFieldCell key="cell" title="Named colours" id="2">
                <font key="font" metaFont="system"/>
                <color key="textColor" name="AccentRed"/>
                <color key="backgroundColor" name="Paper"/>
            </textFieldCell>
        </textField>
        <imageView id="3">
            <rect key="frame" x="0" y="20" width="10" height="6"/>
            <imageCell key="cell" refusesFirstResponder="YES" image="Dot" id="4"/>
        </imageView>
    </objects>
    <resources>
        <image name="Dot" width="10" height="6"/>
        <namedColor name="AccentRed">
            <color red="0.9" green="0.1" blue="0.2" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="Paper">
            <color white="0.93" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </namedColor>
    </resources>
</document>
