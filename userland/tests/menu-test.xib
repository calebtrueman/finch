<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="del" id="c1"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="del" customClass="MenuDelegate">
            <connections>
                <outlet property="recentMenu" destination="recent" id="c2"/>
                <outlet property="fancyItem" destination="fancy" id="c3"/>
                <outlet property="popUp" destination="pop" id="c30"/>
                <outlet property="pullDown" destination="pull" id="c31"/>
            </connections>
        </customObject>
        <menu title="Main Menu" systemMenu="main" id="main">
            <items>
                <menuItem title="Menu Test" id="appItem">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Menu Test" systemMenu="apple" id="appMenu">
                        <items>
                            <menuItem title="About Menu Test" id="about">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="orderFrontStandardAboutPanel:" target="-2" id="c4"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="sep1"/>
                            <menuItem title="Settings…" keyEquivalent="," id="prefs"/>
                            <menuItem isSeparatorItem="YES" id="sep2"/>
                            <menuItem title="Services" id="servicesItem">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Services" systemMenu="services" id="services"/>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="sep3"/>
                            <menuItem title="Hide Menu Test" keyEquivalent="h" id="hide">
                                <connections>
                                    <action selector="hide:" target="-1" id="c5"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="hideOthers">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections>
                                    <action selector="hideOtherApplications:" target="-1" id="c6"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Show All" id="showAll">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="unhideAllApplications:" target="-1" id="c7"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="sep4"/>
                            <menuItem title="Quit Menu Test" keyEquivalent="q" id="quit">
                                <connections>
                                    <action selector="terminate:" target="-1" id="c8"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="fileItem">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="File" id="fileMenu">
                        <items>
                            <menuItem title="New" keyEquivalent="n" tag="11" id="new">
                                <connections>
                                    <action selector="newDocument:" target="-1" id="c9"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Open…" keyEquivalent="o" id="open">
                                <connections>
                                    <action selector="openDocument:" target="-1" id="c10"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Open Recent" id="recentItem">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Open Recent" systemMenu="recentDocuments" id="recent">
                                    <items>
                                        <menuItem title="Clear Menu" id="clear">
                                            <connections>
                                                <action selector="clearRecentDocuments:" target="-1" id="c11"/>
                                            </connections>
                                        </menuItem>
                                    </items>
                                </menu>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="sep5"/>
                            <menuItem title="Close" keyEquivalent="w" id="close">
                                <connections>
                                    <action selector="performClose:" target="-1" id="c12"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Save As…" keyEquivalent="S" id="saveAs">
                                <connections>
                                    <action selector="saveDocumentAs:" target="-1" id="c13"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Fancy" state="on" indentationLevel="2" tag="-7" toolTip="A fancy item" id="fancy">
                                <string key="keyEquivalent" base64-UTF8="YES">
CA
</string>
                                <modifierMask key="keyEquivalentModifierMask" shift="YES" control="YES"/>
                            </menuItem>
                            <menuItem title="Fancier" alternate="YES" state="mixed" id="fancier">
                                <string key="keyEquivalent" base64-UTF8="YES">
CA
</string>
                                <modifierMask key="keyEquivalentModifierMask" shift="YES" control="YES" option="YES"/>
                            </menuItem>
                            <menuItem title="Hidden" hidden="YES" enabled="NO" keyEquivalent="j" id="hiddenItem"/>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Edit" id="editItem">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Edit" autoenablesItems="NO" id="editMenu">
                        <items>
                            <menuItem title="Undo" keyEquivalent="z" id="undo">
                                <connections>
                                    <action selector="undo:" target="-1" id="c14"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Cut" keyEquivalent="x" id="cut">
                                <connections>
                                    <action selector="cut:" target="-1" id="c15"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Delete" id="delete">
                                <string key="keyEquivalent" base64-UTF8="YES">
CA
</string>
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="delete:" target="-1" id="c16"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Find" id="findItem">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Find" id="findMenu">
                                    <items>
                                        <menuItem title="Find…" tag="1" keyEquivalent="f" id="find">
                                            <connections>
                                                <action selector="performFindPanelAction:" target="-1" id="c17"/>
                                            </connections>
                                        </menuItem>
                                    </items>
                                </menu>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="windowItem">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Window" systemMenu="window" id="windowMenu">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="mini">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="c18"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Bring All to Front" id="front">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="arrangeInFront:" target="-1" id="c19"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Help" id="helpItem">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Help" systemMenu="help" id="helpMenu">
                        <items>
                            <menuItem title="Menu Test Help" keyEquivalent="?" id="help">
                                <connections>
                                    <action selector="showHelp:" target="-1" id="c20"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
            <point key="canvasLocation" x="0" y="0"/>
        </menu>
        <window title="Pop-ups" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="popwin">
            <windowStyleMask key="styleMask" titled="YES"/>
            <rect key="contentRect" x="100" y="100" width="300" height="120"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1512" height="982"/>
            <view key="contentView" id="popcontent">
                <rect key="frame" x="0.0" y="0.0" width="300" height="120"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <popUpButton verticalHuggingPriority="750" tag="77" id="pop">
                        <rect key="frame" x="18" y="76" width="160" height="25"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" title="Beta" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" tag="2" imageScaling="proportionallyDown" inset="2" selectedItem="popB" id="popcell">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="menu"/>
                            <menu key="menu" id="popmenu">
                                <items>
                                    <menuItem title="Alpha" tag="1" id="popA"/>
                                    <menuItem title="Beta" state="on" tag="2" id="popB"/>
                                    <menuItem title="Gamma" tag="3" keyEquivalent="g" id="popC"/>
                                </items>
                            </menu>
                        </popUpButtonCell>
                        <connections>
                            <action selector="popChanged:" target="del" id="c32"/>
                        </connections>
                    </popUpButton>
                    <popUpButton verticalHuggingPriority="750" id="pull">
                        <rect key="frame" x="18" y="36" width="160" height="25"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" title="Actions" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" pullsDown="YES" arrowPosition="arrowAtCenter" preferredEdge="maxY" autoenablesItems="NO" id="pullcell">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="menu"/>
                            <menu key="menu" autoenablesItems="NO" id="pullmenu">
                                <items>
                                    <menuItem title="Actions" hidden="YES" id="pullT"/>
                                    <menuItem title="Do This" id="pull1"/>
                                    <menuItem title="Do That" enabled="NO" id="pull2"/>
                                </items>
                            </menu>
                        </popUpButtonCell>
                    </popUpButton>
                </subviews>
            </view>
            <point key="canvasLocation" x="0" y="0"/>
        </window>
        <menu title="Context" id="ctx">
            <items>
                <menuItem title="Copy Link" tag="5" id="ctx1">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="copyLink:" target="del" id="c21"/>
                    </connections>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
