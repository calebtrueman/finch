CoreFoundation for the Objective-C runtime on Darwin: the constant-string
class reference is the ObjC class __NSCFConstantString (a linker alias), and
__CFInitialize gives every CF type its ObjC class first thing
(userland/CoreFoundation/CFObjC.m).


diff --git a/Sources/CoreFoundation/CFRuntime.c b/Sources/CoreFoundation/CFRuntime.c
index 5a5ee09..115cd84 100644
--- a/Sources/CoreFoundation/CFRuntime.c
+++ b/Sources/CoreFoundation/CFRuntime.c
@@ -282,6 +282,13 @@ int __CFConstantStringClassReference[12] = {0};
 #endif
 #endif
 
+#if TARGET_OS_MAC
+// Finch: the compiler's constant-string class is the ObjC class
+// __NSCFConstantString; ___CFConstantStringClassReference is a linker alias
+// of it (userland/CoreFoundation/CFObjC.m and build.sh).
+extern int __CFConstantStringClassReference[];
+void *__CFConstantStringClassReferencePtr = &__CFConstantStringClassReference;
+#else
 #if TARGET_RT_64_BIT
 int __CFConstantStringClassReference[24] = {0};
 #else
@@ -290,6 +297,7 @@ int __CFConstantStringClassReference[12] = {0};
 
 void *__CFConstantStringClassReferencePtr = NULL;
 #endif
+#endif
 
 Boolean _CFIsObjC(CFTypeID typeID, void *obj) {
     return CF_IS_OBJC(typeID, obj);
@@ -1177,6 +1185,13 @@ void __CFInitialize(void) {
     if (!__CFInitialized && !__CFInitializing) {
         __CFInitializing = 1;
 
+#if TARGET_OS_MAC && !DEPLOYMENT_RUNTIME_SWIFT
+        // Finch: every CF type's ObjC class, before any CF object is made
+        // (userland/CoreFoundation/CFObjC.m).
+        extern void __CFFinchInitializeObjC(void);
+        __CFFinchInitializeObjC();
+#endif
+
 #if __HAS_DISPATCH__ && !TARGET_OS_MAC
     // libdispatch has to be initialized before CoreFoundation, so to avoid
     // issues with static initializer ordering, we are doing it explicitly.
