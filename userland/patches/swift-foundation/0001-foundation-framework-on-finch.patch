--- a/Sources/FoundationEssentials/AttributedString/AttributeScope.swift
+++ b/Sources/FoundationEssentials/AttributedString/AttributeScope.swift
@@ -37,7 +37,36 @@ extension AttributeScopes : Sendable {}
 
 import Darwin
 internal import MachO.dyld
-internal import ReflectionInternal
+// Finch: the stored-property types of a scope come from the Swift runtime's
+// field reflection (what the standard library's _forEachField uses) rather
+// than Apple's private ReflectionInternal.
+fileprivate struct _FinchFieldMetadata {
+    var name: UnsafePointer<CChar>? = nil
+    var freeFunc: (@convention(c) (UnsafePointer<CChar>?) -> Void)? = nil
+    var isStrong = false
+    var isVar = false
+}
+@_silgen_name("swift_reflectionMirror_recursiveCount")
+fileprivate func _finchRecursiveChildCount(_: Any.Type) -> Int
+@_silgen_name("swift_reflectionMirror_recursiveChildMetadata")
+fileprivate func _finchChildMetadata(_: Any.Type, index: Int,
+    fieldMetadata: UnsafeMutablePointer<_FinchFieldMetadata>) -> Any.Type
+
+fileprivate struct Type: Hashable {
+    let swiftType: Any.Type
+    init(_ type: Any.Type) { swiftType = type }
+    static func == (a: Type, b: Type) -> Bool { ObjectIdentifier(a.swiftType) == ObjectIdentifier(b.swiftType) }
+    func hash(into hasher: inout Hasher) { hasher.combine(ObjectIdentifier(swiftType)) }
+    struct Field { let type: Type }
+    var fields: [Field] {
+        (0 ..< _finchRecursiveChildCount(swiftType)).map { i in
+            var field = _FinchFieldMetadata()
+            let type = _finchChildMetadata(swiftType, index: i, fieldMetadata: &field)
+            field.freeFunc?(field.name)
+            return Field(type: Type(type))
+        }
+    }
+}
 
