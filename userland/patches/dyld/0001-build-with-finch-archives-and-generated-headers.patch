+// Finch: two exports of Apple's libdyld that the published source lacks.
+// Rosetta uses them to find the x86_64 shared cache's subcaches. Behaviour as
+// in macOS 26.4's libdyld: the first walks the cache's subcaches; the
+// second describes an x86_64 subcache and, for any other cache, reports zero
+// entries and returns false. Finch has no x86_64 cache.
+extern "C" __attribute__((visibility("default")))
+bool dyld_shared_cache_for_each_subcache4Rosetta(dyld_shared_cache_t cache, void (^block)(const void* cacheBuffer, size_t size)) {
+    return ((dyld4::Atlas::SharedCache*)cache)->forEachSubcache4Rosetta(block);
+}
+
+extern "C" __attribute__((visibility("default")))
+bool dyld_shared_subcache_get_info4Rosetta(const void* cacheHeader, uuid_t* uuid, uint64_t* count, uint64_t* a3,
+                                           uint64_t* a4, uint64_t* a5, uint64_t* a6, uint64_t* a7, uint64_t* a8) {
+    (void)uuid; (void)a3; (void)a4; (void)a5; (void)a6; (void)a7; (void)a8;
+    if ( strcmp((const char*)cacheHeader, "dyld_v1  x86_64") != 0 ) {
+        *count = 0;
+        return false;
+    }
+    *count = 0;   // x86_64 caches aren't supported on Finch
+    return false;
+}
