+// Finch: the published source leaves the archive encoding out. This writes
+// what macOS 26.4's dyld writes: one uncompressed Apple Archive (AA01) entry
+// per file, with fields TYP1 F, PATP <path>, DAT<A|B|C> <size> and XATA
+// holding one extended attribute, "com.apple.dyld.crc32c" = {uint32 entry
+// size, uint32 crc32c of the entry up to that crc}. Symlinks are TYP1 L,
+// PATP <from>, LNKP <to>.
+static const char kCRCAttrName[] = "com.apple.dyld.crc32c";
+static const uint32_t kCRCAttrSize = 4 + sizeof(kCRCAttrName) + 4 + 4;
+
+static char dataSizeTag(uint8_t byteSize) {
+    return byteSize <= 2 ? 'A' : (byteSize == 4 ? 'B' : 'C');
+}
+
+static uint8_t dataSizeBytes(size_t size) {
+    uint8_t byteSize = byteSizeForValue(size);
+    return byteSize < 2 ? 2 : byteSize;
+}
