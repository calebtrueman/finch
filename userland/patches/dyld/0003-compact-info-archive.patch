-    size_t headerSize = 0;
-    return headerSize;
+    size_t headerSize = 4 + 2;                          // AA01, header size
+    headerSize += 4 + 1;                                // TYP1 F
+    headerSize += 4 + 2 + strlen(file.path);            // PATP
+    headerSize += 4 + dataSizeBytes(file.data.size());  // DATA/DATB/DATC
+    headerSize += 4 + 2;                                // XATA
+    return (uint16_t)headerSize;
 }
 
