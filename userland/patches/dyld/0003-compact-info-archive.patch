+    output.push_back<uint16_t>(headerSize(file));
+    output.push_back<std::string_view>("TYP1");
+    output.push_back<uint8_t>('F');
+    output.push_back<std::string_view>("PATP");
+    output.push_back<uint16_t>(pathLength);
+    output.push_back<std::string_view>(std::string_view(file.path, pathLength));
+    output.push_back<std::string_view>("DAT");
