+// Finch: dyld publishes its compact info inside an uncompressed Apple Archive
+// (AA01; see AAREncoder.cpp), as process.cinfo. Return that entry's data, or
+// the buffer itself when it isn't an archive (older dyld), or an empty span.
+static std::span<std::byte> compactInfoInArchive(std::span<std::byte> buffer) {
+    const uint8_t* bytes = (const uint8_t*)buffer.data();
+    size_t size = buffer.size();
+    if ( (size < 6) || (memcmp(bytes, "AA01", 4) != 0) ) {
+        return buffer;
+    }
+    size_t entry = 0;
+    while ( entry + 6 <= size && memcmp(&bytes[entry], "AA01", 4) == 0 ) {
+        size_t headerSize = bytes[entry+4] | ((size_t)bytes[entry+5] << 8);
+        if ( (headerSize < 6) || (entry + headerSize > size) ) {
+            break;
+        }
+        const char* path       = nullptr;
+        size_t      pathLength = 0;
+        size_t      blobsSize  = 0;
+        size_t      dataOffset = 0;
+        size_t      dataSize   = 0;
+        bool        haveData   = false;
+        size_t      field      = entry + 6;
+        size_t      headerEnd  = entry + headerSize;
+        bool        malformed  = false;
+        auto readUInt = [&](size_t at, size_t width) {
+            uint64_t value = 0;
+            for ( size_t b = 0; b < width; ++b ) {
+                value |= (uint64_t)bytes[at+b] << (8*b);
+            }
+            return value;
+        };
+        while ( field + 4 <= headerEnd ) {
+            const uint8_t* key = &bytes[field];
+            char type = (char)key[3];
+            field += 4;
+            size_t width = 0;
+            switch ( type ) {
+                case '1': width = 1; break;
+                case '2': width = 2; break;
+                case '4': width = 4; break;
+                case '8': width = 8; break;
+                case 'A': width = 2; break;
+                case 'B': width = 4; break;
+                case 'C': width = 8; break;
+                case 'T': width = 12; break;
+                case 'P':
+                    if ( field + 2 > headerEnd ) { malformed = true; break; }
+                    width = 2 + (size_t)readUInt(field, 2);
+                    break;
+                default:
+                    malformed = true;
+                    break;
+            }
+            if ( malformed || (field + width > headerEnd) ) {
+                malformed = true;
+                break;
+            }
+            if ( type == 'P' && memcmp(key, "PAT", 3) == 0 ) {
+                path       = (const char*)&bytes[field+2];
+                pathLength = width - 2;
+            } else if ( type == 'A' || type == 'B' || type == 'C' ) {
+                size_t blobSize = (size_t)readUInt(field, width);
+                if ( memcmp(key, "DAT", 3) == 0 ) {
+                    dataOffset = headerEnd + blobsSize;
+                    dataSize   = blobSize;
+                    haveData   = true;
+                }
+                blobsSize += blobSize;
+            }
+            field += width;
+        }
+        if ( malformed || (headerEnd + blobsSize > size) ) {
+            break;
+        }
+        if ( haveData && path && pathLength == strlen("process.cinfo") && memcmp(path, "process.cinfo", pathLength) == 0 ) {
+            return buffer.subspan(dataOffset, dataSize);
+        }
+        entry = headerEnd + blobsSize;
+    }
+    return std::span<std::byte>();
+}
